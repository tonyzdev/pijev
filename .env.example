# Copy to .env and start with: node --env-file=.env bin/pijev.mjs
# Or use /login inside PiJev for your coding model.
TYPESAFE_API_KEY=
# Alternatively choose Vercel AI Gateway:
# PIJEV_JEV_PROVIDER=vercel
# AI_GATEWAY_API_KEY=
PIJEV_MODE=assist
# Defaults to jev-latest for TypeSafe, typesafe-ai/jev for Vercel.
# PIJEV_JEV_MODEL=
PIJEV_JEV_TIMEOUT_MS=1800
# Experimental initial source evidence (disabled by default; see docs/experiments.md).
# PIJEV_SOURCE_BRIEFING=1
